# Server only. Never put provider credentials in Unity Resources or source control.
HOST=127.0.0.1
PORT=8787
ENABLE_EXTERNAL_SERVICES=false
DEMO_ACCESS_CODE=
RECIPIENT_LABEL=Guru BK (configure the approved recipient)
# Choose exactly one provider. No automatic fallback to a different company.
AI_PROVIDER=gemini
# Use a NEW key entered privately here, never a key shared in chat.
GEMINI_API_KEY=
# Exact text model ID available to your project, without a models/ prefix.
# Check current model availability, quota, pricing, and eligibility before enabling.
GEMINI_MODEL=
# Optional alternative: used only when AI_PROVIDER=openai.
OPENAI_API_KEY=
# Choose a currently supported, safety-reviewed model before enabling the demo.
OPENAI_MODEL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=
# Explicit Graph API version supported by your Meta app, e.g. vNN.N
WHATSAPP_GRAPH_VERSION=
RECEIPT_DIRECTORY=./private-receipts
